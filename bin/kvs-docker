#!/usr/bin/env bash

# Run the PHAR with the PHP runtime and network of an existing KVS container.
set -euo pipefail

fail() {
    printf 'Error: %s\n' "$*" >&2
    exit 1
}

command -v docker >/dev/null 2>&1 || fail 'Docker is required by the Docker launcher.'

launcher_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
phar=${KVS_CLI_PHAR:-$launcher_dir/kvs.phar}
if [[ -z ${KVS_CLI_PHAR:-} && ! -f $phar && -f $launcher_dir/../kvs.phar ]]; then
    phar=$launcher_dir/../kvs.phar
fi
[[ -f $phar && -r $phar ]] || fail "PHAR not found: $phar. Place kvs.phar beside the launcher or set KVS_CLI_PHAR."
phar=$(cd -- "$(dirname -- "$phar")" && printf '%s/%s' "$PWD" "$(basename -- "$phar")")

requested_path=${KVS_PATH:-}
args=()
while (($#)); do
    case $1 in
        --path)
            (($# >= 2)) && [[ -n $2 ]] || fail '--path requires a directory.'
            requested_path=$2
            shift 2
            ;;
        --path=*)
            requested_path=${1#--path=}
            [[ -n $requested_path ]] || fail '--path requires a directory.'
            shift
            ;;
        --)
            args+=("$@")
            break
            ;;
        *)
            args+=("$1")
            shift
            ;;
    esac
done

# Older PHAR releases do not know that their container copy is temporary.
for arg in "${args[@]}"; do
    [[ $arg == -* ]] && continue
    case $arg in
        sel|self|self-*|selfu*|self:*)
            fail 'Update kvs.phar and the Docker launcher on the host using the Docker installation instructions.'
            ;;
    esac
    break
done

if [[ -n $requested_path && -d $requested_path ]]; then
    requested_path=$(cd -- "$requested_path" && pwd -P)
fi
[[ $requested_path == / ]] || requested_path=${requested_path%/}
current_dir=$(pwd -P)

candidates=()
if [[ -n ${KVS_DOCKER_CONTAINER:-} ]]; then
    [[ $(docker inspect --format '{{.State.Running}}' "$KVS_DOCKER_CONTAINER") == true ]] ||
        fail "Container is not running: $KVS_DOCKER_CONTAINER"
    candidates+=("$KVS_DOCKER_CONTAINER")
else
    containers=$(docker ps --format '{{.Names}}\t{{.Label "com.docker.compose.service"}}') ||
        fail 'Cannot list Docker containers. Check the Docker daemon and permissions.'
    while IFS=$'\t' read -r name service; do
        if [[ -n $name && ( $service == php-fpm || $name == *-php ) ]]; then
            candidates+=("$name")
        fi
    done <<< "$containers"
fi

matched_containers=()
matched_paths=()
local_containers=()
local_paths=()
for candidate in "${candidates[@]}"; do
    mounts=$(docker inspect --format '{{range .Mounts}}{{printf "%s\t%s\n" .Source .Destination}}{{end}}' "$candidate") ||
        fail "Cannot inspect container: $candidate"
    while IFS=$'\t' read -r source destination; do
        [[ -n $source && -n $destination ]] || continue
        if [[ -d $source ]]; then
            source=$(cd -- "$source" && pwd -P)
        fi
        if [[ -n $requested_path && $requested_path != "$source" && $requested_path != "$destination" ]]; then
            continue
        fi
        if ! docker exec "$candidate" test -f "${destination%/}/admin/include/setup.php" </dev/null; then
            continue
        fi
        matched_containers+=("$candidate")
        matched_paths+=("$destination")
        if [[ $current_dir == "$source" || $current_dir == "${source%/}/"* ]]; then
            local_containers+=("$candidate")
            local_paths+=("$destination")
        fi
    done <<< "$mounts"
done

if [[ -z $requested_path && ${#local_containers[@]} -gt 0 ]]; then
    matched_containers=("${local_containers[@]}")
    matched_paths=("${local_paths[@]}")
fi
if ((${#matched_containers[@]} == 0)); then
    fail 'No matching running KVS PHP container. Use --path=/host/site or set KVS_DOCKER_CONTAINER.'
fi
if ((${#matched_containers[@]} != 1)); then
    printf 'Error: Multiple KVS sites match. Use --path=/host/site or set KVS_DOCKER_CONTAINER:\n' >&2
    printf '  %s\n' "${matched_containers[@]}" >&2
    exit 1
fi

container=${matched_containers[0]}
container_path=${matched_paths[0]}
runtime_dir=$(docker exec "$container" sh -c '
runtime_dir=$(mktemp -d -t kvs-cli.XXXXXXXXXX) || exit 1
if ! : > "$runtime_dir/pending"; then
    rm -rf -- "$runtime_dir"
    exit 1
fi
printf "%s\n" "$runtime_dir"
') ||
    fail "Cannot create a temporary directory in $container."
[[ $runtime_dir == /* && $runtime_dir != / && $runtime_dir != *$'\n'* ]] ||
    fail 'Docker returned an invalid temporary directory.'
execution_pid=
keep_runtime=false
# The pending token prevents a canceled invocation from starting PHP work later.
# shellcheck disable=SC2016
stop_php='
runtime_dir=$1
signal=$2
if mv "$runtime_dir/pending" "$runtime_dir/canceled" 2>/dev/null; then
    exit 0
fi
[ -e "$runtime_dir/running" ] || exit 0
read -r pid started < "$runtime_dir/php.pid" || exit 1
case $pid in ""|0|1|*[!0-9]*) exit 1 ;; esac
case $started in ""|*[!0-9]*) exit 1 ;; esac
is_running() {
    [ -r "/proc/$pid/stat" ] || return 1
    stat=$(cat "/proc/$pid/stat" 2>/dev/null) || return 1
    stat=${stat##*) }
    state=${stat%% *}
    case $state in Z|X) return 1 ;; esac
    current_started=$(printf "%s\n" "$stat" | cut -d " " -f 20)
    [ "$current_started" = "$started" ]
}
is_running || exit 0
kill -s "$signal" "$pid" 2>/dev/null || true
attempt=0
while is_running && [ "$attempt" -lt 50 ]; do
    sleep 0.1
    attempt=$((attempt + 1))
done
if is_running; then
    kill -KILL "$pid" 2>/dev/null || true
    attempt=0
    while is_running && [ "$attempt" -lt 20 ]; do
        sleep 0.1
        attempt=$((attempt + 1))
    done
fi
! is_running
'
# shellcheck disable=SC2329
cleanup() {
    if [[ $keep_runtime == false ]]; then
        docker exec "$container" rm -rf -- "$runtime_dir" </dev/null >/dev/null 2>&1 || true
    fi
}
# shellcheck disable=SC2329
interrupt() {
    trap '' HUP INT TERM
    if ! docker exec "$container" sh -c "$stop_php" sh "$runtime_dir" "$1" </dev/null; then
        keep_runtime=true
        printf 'Error: Could not stop container PHP; runtime retained at %s:%s.\n' "$container" "$runtime_dir" >&2
    fi
    if [[ -n $execution_pid ]]; then
        kill -TERM "$execution_pid" 2>/dev/null || true
        wait "$execution_pid" 2>/dev/null || true
    fi
    exit "$2"
}
trap cleanup EXIT
trap 'interrupt HUP 129' HUP
trap 'interrupt INT 130' INT
trap 'interrupt TERM 143' TERM

docker cp -q -L -- "$phar" "$container:$runtime_dir/kvs.phar"
exec_options=(-i)
if [[ -t 0 && -t 1 ]]; then
    exec_options+=(-t)
fi
for kvs_variable in KVS_DB_HOST KVS_DB_USER KVS_DB_PASS KVS_DB_NAME KVS_DB_PORT \
    KVS_ENV KVS_ALLOW_EVAL KVS_BENCHMARK_API_URL; do
    if [[ ${!kvs_variable+x} ]]; then
        # Passing only the name keeps the value out of Docker's argument list.
        exec_options+=(-e "$kvs_variable")
    fi
done
# Symfony uses PHP_SELF in help examples; keep the public command name while
# preserving the actual PHAR path in argv for commands that inspect their runtime.
# shellcheck disable=SC2016
php_bootstrap='
array_shift($argv);
$argc = count($argv);
$_SERVER["argv"] = $argv;
$_SERVER["argc"] = $argc;
$_SERVER["PHP_SELF"] = "kvs";
$runtimeDirectory = dirname($argv[0]);
$processStat = @file_get_contents("/proc/self/stat");
if ($processStat === false || ($statEnd = strrpos($processStat, ") ")) === false) {
    exit(1);
}
$processFields = explode(" ", substr($processStat, $statEnd + 2));
$processIdentity = getmypid() . " " . $processFields[19] . "\n";
if (@file_put_contents($runtimeDirectory . "/php.pid.tmp", $processIdentity) === false ||
    !@rename($runtimeDirectory . "/php.pid.tmp", $runtimeDirectory . "/php.pid") ||
    !@rename($runtimeDirectory . "/pending", $runtimeDirectory . "/running")) {
    exit(1);
}
require $argv[0];
'
# An explicit stdin descriptor keeps pipes and interactive input available to
# the asynchronous Docker client while wait remains interruptible.
exec 3<&0
docker exec "${exec_options[@]}" -e KVS_CLI_DOCKER_LAUNCHER=1 -e "KVS_PATH=$container_path" \
    -w "$container_path" "$container" php -r "$php_bootstrap" "$runtime_dir/kvs.phar" --path="$container_path" "${args[@]}" <&3 &
execution_pid=$!
exec 3<&-
status=0
wait "$execution_pid" || status=$?
execution_pid=
exit "$status"
